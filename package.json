{
  "name": "webapp",
  "version": "1.0.0",
  "description": "A web application with a React frontend and Express backend.",
  "main": "index.js",
  "scripts": {
    "start:server": "node server/app.js",
    "start:client": "cd client && npm start",
    "start": "npm run start:server",
    "build:client": "cd client && npm run build && cp -r client/build/* ../public/",
    "build": "npm run build:client",
    "sitemap": "node server/sitemap-generator.js",
    "copy:build": "node copy-build.js",
    "test": "cd client && npm run build && cd .. && npm run copy:build && cd server && node app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.5",
    "bcrypt": "^5.1.1",
    "bip32": "^4.0.0",
    "bitcoinjs-lib": "^6.0.0",
    "buffer": "^6.0.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^0.453.0",
    "mongoose": "^8.6.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
